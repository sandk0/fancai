# =============================================================================
# fancai — Environment Variables
# =============================================================================
# Copy to .env and fill in values for your environment.
# All variables without defaults are REQUIRED.

# --- Application ---
SECRET_KEY=           # REQUIRED. Generate: python -c "import secrets; print(secrets.token_urlsafe(64))"
DEBUG=false

# --- Database (PostgreSQL) ---
POSTGRES_USER=fancai_user
POSTGRES_PASSWORD=    # REQUIRED. Generate: openssl rand -base64 32
POSTGRES_DB=fancai
DATABASE_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}

# --- Redis ---
REDIS_PASSWORD=       # REQUIRED. Generate: openssl rand -base64 32
REDIS_URL=redis://:${REDIS_PASSWORD}@redis:6379/0

# --- AI / OpenRouter (all LLM and image generation) ---
OPENROUTER_API_KEY=   # REQUIRED. Get: https://openrouter.ai/settings/keys
OPENROUTER_IMAGE_MODEL=black-forest-labs/flux.2-klein-4b  # Available: flux.2-klein-4b, flux-pro

# --- Error Monitoring (Hawk Tracker) ---
HAWK_TOKEN=           # Get: https://hawk-tracker.ru — create project, copy integration token

# --- Infrastructure Monitoring (monitor.fancai.ru) ---
MONITOR_PASSWORD_HASH=  # Generate: docker run caddy:alpine caddy hash-password --plaintext YOUR_PASSWORD
METRICS_USER=admin
METRICS_PASSWORD=       # REQUIRED. Password for /health/metrics endpoint (Prometheus scraping)

# --- Email (optional) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=noreply@fancai.ru

# --- Push Notifications (VAPID, optional) ---
VAPID_PRIVATE_KEY=
VAPID_PUBLIC_KEY=
VAPID_SUBJECT=mailto:admin@fancai.ru
