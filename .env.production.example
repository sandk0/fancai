# fancai Production Environment Configuration
# Copy this file to .env and fill in real values before deployment
# NEVER commit .env with real secrets to version control

# ============================================================================
# REQUIRED — deployment will fail without these
# ============================================================================

# Domain
DOMAIN_NAME=fancai.ru
DOMAIN_URL=https://fancai.ru

# Database
DB_NAME=fancai
DB_USER=fancai
DB_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD

# Redis
REDIS_PASSWORD=CHANGE_ME_STRONG_REDIS_PASSWORD

# Application secret (used for JWT signing)
SECRET_KEY=CHANGE_ME_GENERATE_WITH_openssl_rand_hex_64

# ============================================================================
# AI Services
# ============================================================================

# OpenRouter API key (for Gemini 3.0 Flash + FLUX.2 Klein)
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxx

# ============================================================================
# Authentication
# ============================================================================

ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ============================================================================
# Email and password recovery (Yandex Cloud Postbox)
# ============================================================================

EMAIL_ENABLED=true
EMAIL_FROM=noreply@fancai.ru
EMAIL_FROM_NAME=fancai
PASSWORD_RESET_BASE_URL=https://fancai.ru/reset-password
YANDEX_POSTBOX_ACCESS_KEY=CHANGE_ME_POSTBOX_ACCESS_KEY
YANDEX_POSTBOX_SECRET_KEY=CHANGE_ME_POSTBOX_SECRET_KEY
YANDEX_POSTBOX_ENDPOINT=https://postbox.cloud.yandex.net
YANDEX_POSTBOX_REGION=ru-central1

# ============================================================================
# Web Push Notifications (VAPID keys)
# ============================================================================

# Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@fancai.ru

# ============================================================================
# Monitoring
# ============================================================================

# Hawk error tracking (https://hawk.so)
HAWK_TOKEN=

# Monitoring dashboard auth — Caddy basic_auth, пользователь захардкожен как admin
# (Caddyfile:72,100). Хэш, не пароль:
#   docker run --rm caddy:alpine caddy hash-password --plaintext YOUR_PASSWORD
MONITOR_PASSWORD_HASH=CHANGE_ME_BCRYPT_HASH

# ============================================================================
# Performance tuning
# ============================================================================

LOG_LEVEL=INFO
WORKERS_COUNT=2
CELERY_CONCURRENCY=2
MAX_FILE_SIZE=52428800
