# =============================================================================
# Development Dockerfile for fancai Backend
# =============================================================================
# Тот же набор зависимостей, что и в боевом образе, плюс dev-группа
# (pytest, black, ruff, mypy). Локальных NLP-моделей в проекте больше нет:
# извлечение сущностей целиком идёт через LLM-провайдера.
# =============================================================================
# syntax=docker/dockerfile:1.4
FROM python:3.12-slim

# Окружение живёт в /opt/venv, а не в /app/.venv и не в системном префиксе:
# compose монтирует ./backend в /app и скрыл бы venv из образа, а установка
# в /usr/local заставила бы `uv sync` считать лишними pip и сам uv.
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PYTHONPATH=/app \
    UV_PROJECT_ENVIRONMENT=/opt/venv \
    UV_NO_CACHE=1 \
    PATH=/opt/venv/bin:$PATH

# Install system dependencies (minimal set).
# libmagic1 удалён: ни python-magic в зависимостях, ни импортов magic
# в backend/ нет — пакет тянулся впустую.
RUN apt-get update && apt-get install -y \
    build-essential \
    curl \
    libpq-dev \
    && rm -rf /var/lib/apt/lists/*

# OCI-метки: без них связь «образ ↔ коммит» недоказуема.
ARG VCS_REF=unknown
ARG BUILD_DATE=unknown
ARG IMAGE_VERSION=unknown
LABEL org.opencontainers.image.title="fancai-backend-dev" \
      org.opencontainers.image.source="https://github.com/sandk/fancai" \
      org.opencontainers.image.revision="${VCS_REF}" \
      org.opencontainers.image.created="${BUILD_DATE}" \
      org.opencontainers.image.version="${IMAGE_VERSION}"

# Create working directory
WORKDIR /app

# Зависимости ставятся из uv.lock: точное разрешение с хешами, одинаковое
# в любой пересборке. Отдельный слой до COPY исходников — правки кода
# не инвалидируют установку.
COPY pyproject.toml uv.lock ./

# Без --no-dev: dev-образ должен уметь гонять pytest и линтеры.
RUN pip install --no-cache-dir uv==0.11.25 && \
    uv sync --frozen && \
    echo "✅ Dependencies installed from uv.lock"

# Copy source code
COPY . .

# Create necessary directories
RUN mkdir -p /app/logs /app/storage

# Create non-root user
RUN groupadd -r appuser && useradd -r -g appuser appuser && \
    chown -R appuser:appuser /app

# Switch to non-root user
USER appuser

# Expose port
EXPOSE 8000

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=30s --retries=3 \
  CMD curl -f http://localhost:8000/health || exit 1

# Default command
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000", "--reload", "--reload-dir", "/app/app"]
