# =============================================================================
# Development Dockerfile for fancai Backend
# =============================================================================
# Lightweight version without heavy NLP dependencies:
# - No SpaCy models (~500MB)
# - No Stanza models (~630MB)
# - No GLiNER models (~500MB)
# - No NLTK data (~100MB)
#
# Total image size: ~800MB (vs ~2.5GB for full version)
# Build time: ~2-3 minutes (vs ~10-15 minutes for full version)
# =============================================================================
# syntax=docker/dockerfile:1.4
FROM python:3.12-slim

# Set environment variables
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PYTHONPATH=/app

# Install system dependencies (minimal set).
# libmagic1 удалён: ни python-magic в requirements.txt, ни импортов magic
# в backend/ нет — пакет тянулся впустую.
RUN apt-get update && apt-get install -y \
    build-essential \
    curl \
    libpq-dev \
    && rm -rf /var/lib/apt/lists/*

# OCI-метки: без них связь «образ ↔ коммит» недоказуема.
ARG VCS_REF=unknown
ARG BUILD_DATE=unknown
ARG IMAGE_VERSION=unknown
LABEL org.opencontainers.image.title="fancai-backend-dev" \
      org.opencontainers.image.source="https://github.com/sandk/fancai" \
      org.opencontainers.image.revision="${VCS_REF}" \
      org.opencontainers.image.created="${BUILD_DATE}" \
      org.opencontainers.image.version="${IMAGE_VERSION}"

# Create working directory
WORKDIR /app

# Copy requirements
COPY requirements.txt .

# Install Python dependencies
# Note: --no-cache-dir forces fresh download, ensuring latest versions
RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir -r requirements.txt && \
    echo "✅ Dependencies installed"

# Copy source code
COPY . .

# Create necessary directories
RUN mkdir -p /app/logs /app/storage

# Create non-root user
RUN groupadd -r appuser && useradd -r -g appuser appuser && \
    chown -R appuser:appuser /app

# Switch to non-root user
USER appuser

# Expose port
EXPOSE 8000

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=30s --retries=3 \
  CMD curl -f http://localhost:8000/health || exit 1

# Default command
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000", "--reload", "--reload-dir", "/app/app"]
