# =============================================================================
# Production Dockerfile for fancai Backend
# =============================================================================
# Production image — all AI via OpenRouter.
#
# Image size: ~600MB
# =============================================================================

# Multi-stage build for minimal production image
FROM python:3.12-slim as builder

# Окружение — отдельный venv в /opt/venv: копируется между стадиями одним
# путём и не перемешивается с системным префиксом, где живут pip и uv.
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    UV_PROJECT_ENVIRONMENT=/opt/venv \
    UV_NO_CACHE=1

# Install build dependencies
# build-essential уже приносит gcc, g++, make и libc6-dev —
# отдельные gcc и g++ были избыточны.
RUN apt-get update && apt-get install -y \
    libpq-dev \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

# Зависимости из uv.lock: точное разрешение с хешами, одинаковое в любой
# пересборке. --no-dev выкидывает pytest/black/ruff/mypy, которым в боевом
# образе делать нечего (при pip они туда попадали).
WORKDIR /tmp/build
COPY pyproject.toml uv.lock ./
RUN pip install --no-cache-dir uv==0.11.25 && \
    uv sync --frozen --no-dev

# =============================================================================
# Production stage
# =============================================================================
FROM python:3.12-slim as production

# Set environment variables
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONPATH=/app \
    PATH=/opt/venv/bin:$PATH

# Install runtime dependencies only (minimal)
RUN apt-get update && apt-get install -y \
    libpq5 \
    curl \
    && rm -rf /var/lib/apt/lists/*

# OCI-метки: без них связь «образ ↔ коммит» недоказуема. Аудит 2026-08-01
# упёрся ровно в это — на проде лежал артефакт без опознавательных знаков.
ARG VCS_REF=unknown
ARG BUILD_DATE=unknown
ARG IMAGE_VERSION=unknown
LABEL org.opencontainers.image.title="fancai-backend" \
      org.opencontainers.image.source="https://github.com/sandk/fancai" \
      org.opencontainers.image.revision="${VCS_REF}" \
      org.opencontainers.image.created="${BUILD_DATE}" \
      org.opencontainers.image.version="${IMAGE_VERSION}"

# Create app user for security
RUN groupadd -r appuser && useradd -r -g appuser appuser

# Готовое окружение целиком: один каталог вместо копирования системного
# site-packages и /usr/local/bin, куда попадали и pip, и uv.
COPY --from=builder /opt/venv /opt/venv

# Set work directory
WORKDIR /app

# Copy application code
COPY --chown=appuser:appuser . .

# Create necessary directories with proper permissions and make entrypoint executable
RUN mkdir -p /app/logs /app/storage/books /app/storage/books/covers /app/storage/images && \
    chown -R appuser:appuser /app && \
    chmod -R 755 /app && \
    chmod -R 775 /app/storage /app/logs && \
    chmod +x /app/entrypoint.prod.sh

# Switch to non-root user
USER appuser

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=30s --retries=3 \
  CMD python healthcheck.py || exit 1

# Expose port
EXPOSE 8000

# Entrypoint handles env validation, then hands off to CMD via exec "$@"
ENTRYPOINT ["/app/entrypoint.prod.sh"]

# Default: gunicorn using config file (single source of truth)
CMD ["gunicorn", "-c", "gunicorn.conf.py", "app.main:app"]
