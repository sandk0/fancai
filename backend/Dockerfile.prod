# =============================================================================
# Production Dockerfile for fancai Backend and Celery Worker
# =============================================================================
# Один файл на два образа. До 2026-08-05 рядом лежал Dockerfile.celery,
# отличавшийся пятью строками (LABEL, mkdir, HEALTHCHECK, EXPOSE, CMD) —
# и расходившийся с этим при каждой правке зависимостей. Набор пакетов стал
# одинаковым после удаления GLiNER2 (решение S4), так что общими остаются
# и стадия сборки, и рантайм.
#
# Собирать через target:
#   docker build --target backend -t fancai-backend:latest ./backend
#   docker build --target celery  -t fancai-celery:latest  ./backend
# BuildKit собирает только предков запрошенного таргета, поэтому лишняя
# финальная стадия ничего не стоит.
#
# Image size: ~600MB
# =============================================================================

# Multi-stage build for minimal production image
# База — alpine, а не debian-slim. Замер trivy на одном и том же коде:
# python:3.12-slim  — 250 CVE (4 critical, 25 high), патчей нет НИ ДЛЯ ОДНОЙ
#                     из critical/high: это неисправленные баги Debian
#                     в perl-base, ncurses, libblkid — пакетах, которых
#                     приложение вообще не вызывает;
# python:3.12-alpine — 5 CVE, все medium/low и все с доступным патчем.
# Нативные расширения (asyncpg, greenlet, pydantic-core, lxml, cryptography,
# aiohttp, uvloop, httptools) ставятся из musllinux-колёс, сборка из исходников
# не требуется.
FROM python:3.12-alpine AS builder

# Окружение — отдельный venv в /opt/venv: копируется между стадиями одним
# путём и не перемешивается с системным префиксом, где живут pip и uv.
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    UV_PROJECT_ENVIRONMENT=/opt/venv \
    UV_NO_CACHE=1

# Install build dependencies
# build-base — аналог build-essential (gcc, g++, make, musl-dev).
# Остальное нужно, если для какого-то пакета не окажется musllinux-колеса:
# postgresql-dev для asyncpg, libxml2/libxslt для lxml, libffi/openssl
# для cryptography.
RUN apk add --no-cache \
    build-base \
    postgresql-dev \
    libxml2-dev \
    libxslt-dev \
    libffi-dev \
    openssl-dev

# Зависимости из uv.lock: точное разрешение с хешами, одинаковое в любой
# пересборке. --no-dev выкидывает pytest/black/ruff/mypy, которым в боевом
# образе делать нечего (при pip они туда попадали).
WORKDIR /tmp/build
COPY pyproject.toml uv.lock ./
RUN pip install --no-cache-dir uv==0.11.25 && \
    uv sync --frozen --no-dev

# =============================================================================
# Общий рантайм: код, окружение, пользователь, права
# =============================================================================
FROM python:3.12-alpine AS runtime

# Set environment variables
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONPATH=/app \
    PATH=/opt/venv/bin:$PATH

# Install runtime dependencies only (minimal)
# libxml2/libxslt — рантайм-часть для lxml (парсер EPUB/FB2).
RUN apk add --no-cache \
    libpq \
    curl \
    libxml2 \
    libxslt

# Системный pip выброшен из рантайма — он единственный источник оставшихся CVE.
#
# Обновить его недостаточно: pip версии 26 вендорит внутри себя msgpack 1.1.2
# и setuptools 70.3.0, и trivy находит уже их (2 HIGH + 1 MEDIUM). То есть
# апгрейд меняет CVE самого pip на CVE его вендора.
#
# Удаление безопасно: венв собирается в builder-стадии и копируется готовым
# (`uv` pip в него не сеет — /opt/venv/bin/pip отсутствует), а в рантайме pip
# не вызывает ни entrypoint, ни healthcheck, ни gunicorn. Путь берётся
# из sysconfig, чтобы не зашивать версию Python.
RUN PURELIB="$(python -c 'import sysconfig; print(sysconfig.get_paths()["purelib"])')" && \
    rm -rf "$PURELIB"/pip "$PURELIB"/pip-*.dist-info /usr/local/bin/pip*

# OCI-метки: без них связь «образ ↔ коммит» недоказуема. Аудит 2026-08-01
# упёрся ровно в это — на проде лежал артефакт без опознавательных знаков.
ARG VCS_REF=unknown
ARG BUILD_DATE=unknown
ARG IMAGE_VERSION=unknown
LABEL org.opencontainers.image.source="https://github.com/sandk/fancai" \
      org.opencontainers.image.revision="${VCS_REF}" \
      org.opencontainers.image.created="${BUILD_DATE}" \
      org.opencontainers.image.version="${IMAGE_VERSION}"

# Create app user for security.
#
# UID/GID закреплены ЯВНО и менять их нельзя. Боевые данные лежат
# в bind-mount `backend/storage` на хосте и принадлежат конкретному
# числовому владельцу — имя `appuser` для ядра не значит ничего.
# Пока база была `python:3.12-slim`, `adduser -S` выдавал 999:999;
# после перехода на alpine тот же вызов выдал 100:101, и 2026-08-05
# на проде это молча отняло у бэкенда и воркера право писать
# в /app/storage (загрузка книг и генерация иллюстраций падали),
# а у beat — право пересоздать /tmp/celerybeat-schedule, из-за чего
# он ушёл в цикл перезапуска.
#
# Явные `-u`/`-g` делают отказ громким: при смене базы, где эти
# идентификаторы заняты, упадёт СБОРКА, а не прод.
RUN addgroup -S -g 101 appuser && adduser -S -u 100 -G appuser appuser

# Готовое окружение целиком: один каталог вместо копирования системного
# site-packages и /usr/local/bin, куда попадали и pip, и uv.
COPY --from=builder /opt/venv /opt/venv

# Set work directory
WORKDIR /app

# Copy application code
COPY --chown=appuser:appuser . .

# Create necessary directories with proper permissions and make entrypoint executable
# Подкаталоги storage нужны обоим: воркер пишет сгенерированные иллюстрации
# в /app/storage/images, бэкенд — обложки и книги.
RUN mkdir -p /app/logs /app/storage/books /app/storage/books/covers /app/storage/images && \
    chown -R appuser:appuser /app && \
    chmod -R 755 /app && \
    chmod -R 775 /app/storage /app/logs && \
    chmod +x /app/entrypoint.prod.sh

# Switch to non-root user
USER appuser

# Entrypoint handles env validation, then hands off to CMD via exec "$@"
ENTRYPOINT ["/app/entrypoint.prod.sh"]

# =============================================================================
# Backend API — gunicorn
# =============================================================================
FROM runtime AS backend

LABEL org.opencontainers.image.title="fancai-backend"

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=30s --retries=3 \
  CMD python healthcheck.py || exit 1

# Expose port
EXPOSE 8000

# Default: gunicorn using config file (single source of truth)
CMD ["gunicorn", "-c", "gunicorn.conf.py", "app.main:app"]

# =============================================================================
# Celery Worker
# =============================================================================
FROM runtime AS celery

LABEL org.opencontainers.image.title="fancai-celery"

# Health check — брокер отвечает не мгновенно после старта контейнера.
HEALTHCHECK --interval=60s --timeout=15s --start-period=30s --retries=3 \
  CMD celery -A app.core.celery_app inspect ping --timeout 10 || exit 1

# concurrency=1: обработка книги внутри одной задачи уже распараллелена по
# главам через asyncio.gather, поэтому воркер берёт по одной книге за раз.
# -Q перечисляет все три очереди: без него воркер слушает только
# task_default_queue ("normal"), а beat шлёт периодические задачи в "light".
CMD ["celery", "-A", "app.core.celery_app", "worker", "--loglevel=info", "--concurrency=1", "--prefetch-multiplier=1", "-Q", "heavy,normal,light"]
