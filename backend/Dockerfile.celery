# =============================================================================
# Production Dockerfile for fancai Celery Worker (NLP)
# =============================================================================
# Celery worker with PyTorch CPU-only + NLP dependencies (GLiNER2,
# sentence-transformers) for local entity extraction and embeddings.
#
# Separate from Dockerfile.prod to keep API image lean (~600MB).
# This image is ~2.5GB due to PyTorch + NLP models.
#
# Image: fancai-celery:latest
# =============================================================================

# Multi-stage build for minimal production image
FROM python:3.12-slim as builder

# Окружение — отдельный venv в /opt/venv: копируется между стадиями одним
# путём и не перемешивается с системным префиксом, где живут pip и uv.
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    UV_PROJECT_ENVIRONMENT=/opt/venv \
    UV_NO_CACHE=1

# build-essential уже приносит gcc, g++, make и libc6-dev —
# отдельные gcc и g++ были избыточны.
RUN apt-get update && apt-get install -y \
    libpq-dev \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /tmp/build

# Всё одним разрешением из uv.lock, включая torch: индекс PyTorch объявлен
# в pyproject.toml как explicit, поэтому оттуда берётся только torch,
# а остальные пакеты по-прежнему идут с PyPI. Прежде torch и gliner2
# ставились тремя отдельными `pip install` мимо какого-либо lock-файла.
# --extra nlp — единственное отличие от API-образа.
COPY pyproject.toml uv.lock ./
RUN pip install --no-cache-dir uv==0.11.25 && \
    uv sync --frozen --no-dev --extra nlp

# =============================================================================
# Production stage
# =============================================================================
FROM python:3.12-slim as production

# Set environment variables
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONPATH=/app \
    HF_HOME=/models \
    PATH=/opt/venv/bin:$PATH

# Install runtime dependencies only (minimal)
RUN apt-get update && apt-get install -y \
    libpq5 \
    curl \
    && rm -rf /var/lib/apt/lists/*

# OCI-метки: без них связь «образ ↔ коммит» недоказуема. Аудит 2026-08-01
# упёрся ровно в это — на проде лежал артефакт без опознавательных знаков.
ARG VCS_REF=unknown
ARG BUILD_DATE=unknown
ARG IMAGE_VERSION=unknown
LABEL org.opencontainers.image.title="fancai-celery" \
      org.opencontainers.image.source="https://github.com/sandk/fancai" \
      org.opencontainers.image.revision="${VCS_REF}" \
      org.opencontainers.image.created="${BUILD_DATE}" \
      org.opencontainers.image.version="${IMAGE_VERSION}"

# Create app user for security
RUN groupadd -r appuser && useradd -r -g appuser appuser

# Готовое окружение целиком: один каталог вместо копирования системного
# site-packages и /usr/local/bin, куда попадали и pip, и uv.
COPY --from=builder /opt/venv /opt/venv

# Set work directory
WORKDIR /app

# Copy application code
COPY --chown=appuser:appuser . .

# Create necessary directories with proper permissions and make entrypoint executable
RUN mkdir -p /app/logs /app/storage /models && \
    chown -R appuser:appuser /app /models && \
    chmod -R 755 /app && \
    chmod -R 775 /app/storage /app/logs /models && \
    chmod +x /app/entrypoint.prod.sh

# Switch to non-root user
USER appuser

# Health check (NLP models take longer to load — 120s start period)
HEALTHCHECK --interval=60s --timeout=15s --start-period=120s --retries=3 \
  CMD celery -A app.core.celery_app inspect ping --timeout 10 || exit 1

# Entrypoint handles env validation, then hands off to CMD via exec "$@"
ENTRYPOINT ["/app/entrypoint.prod.sh"]

# Celery worker: concurrency=1 (one NLP process), no max-tasks-per-child
# (omitting = None = unlimited, models persist in memory, worker never restarts)
# NOTE: Memory limit per child is NOT set — it would kill NLP workers that legitimately use 2-3GB
CMD ["celery", "-A", "app.core.celery_app", "worker", "--loglevel=info", "--concurrency=1", "--prefetch-multiplier=1"]
