{
    email admin@fancai.ru
}

fancai.ru {
    # IP whitelist — handle @blocked MUST be the first handle block
    @blocked not remote_ip 77.246.110.17 159.195.46.185 176.120.214.188 176.120.204.191 81.163.40.118 81.163.40.39
    handle @blocked {
        respond 403
    }

    # Сжатие
    encode zstd gzip

    # API бэкенда
    handle /api/* {
        reverse_proxy backend:8000 {
            header_up X-Real-IP {remote_host}
            header_up X-Forwarded-For {remote_host}
            transport http {
                dial_timeout 5s
                response_header_timeout 120s
                read_timeout 130s
            }
        }
    }

    # WebSocket
    handle /ws/* {
        reverse_proxy backend:8000
    }

    # Storage (изображения)
    handle /storage/* {
        root * /var/www
        file_server
    }

    # Frontend SPA (catch-all — должен быть последним)
    handle {
        root * /var/www/frontend
        try_files {path} /index.html
        file_server
    }

    # Upload limit для EPUB
    @uploads {
        path /api/v1/books/upload /api/v1/books/*/upload
    }
    request_body @uploads {
        max_size 50MB
    }

    # Security headers
    header {
        Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' blob: https://fonts.googleapis.com; style-src-elem 'self' 'unsafe-inline' blob: https://fonts.googleapis.com; font-src 'self' blob: data: https://fonts.gstatic.com; img-src 'self' data: blob: https:; connect-src 'self' https://*.fancai.ru wss://*.fancai.ru https://fonts.googleapis.com https://fonts.gstatic.com wss://*.hawk.so https://image.pollinations.ai; media-src 'self' blob:; worker-src 'self' blob:; frame-src 'self' blob:; object-src 'none'; base-uri 'self';"
        X-Frame-Options SAMEORIGIN
        X-Content-Type-Options nosniff
        Referrer-Policy strict-origin-when-cross-origin
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        Permissions-Policy "geolocation=(), microphone=(), camera=(), payment=()"
        Cross-Origin-Opener-Policy "same-origin"
        -Server
    }
}

# Мониторинг-дашборд — basicauth + reverse_proxy к 4 сервисам (Uptime Kuma — отдельный поддомен)
monitor.fancai.ru {
    encode zstd gzip

    basic_auth {
        admin {$MONITOR_PASSWORD_HASH}
    }

    handle /netdata/* {
        uri strip_prefix /netdata
        reverse_proxy fancai_netdata:19999
    }

    handle /victoria/* {
        uri strip_prefix /victoria
        reverse_proxy fancai_victoriametrics:8428
    }

    handle /dozzle/* {
        uri strip_prefix /dozzle
        reverse_proxy fancai_dozzle:8080
    }

    # Flower остаётся до отдельного решения владельца (2026-08-05).
    # Контейнер живёт в docker-compose.monitoring.yml и работает на проде;
    # маршрут убирать нельзя, иначе выкатка молча отрежет UI очередей.
    handle /flower/* {
        uri strip_prefix /flower
        reverse_proxy fancai_flower:5555
    }

    handle {
        redir * /netdata/ permanent
    }
}

# Uptime Kuma — отдельный поддомен (не поддерживает subpath)
uptime.fancai.ru {
    encode zstd gzip

    basic_auth {
        admin {$MONITOR_PASSWORD_HASH}
    }

    reverse_proxy fancai_uptime_kuma:3001
}

# www -> non-www редирект
www.fancai.ru {
    redir https://fancai.ru{uri} permanent
}
