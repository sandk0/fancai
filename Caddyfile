{
    email admin@fancai.ru
}

fancai.ru {
    # Сжатие
    encode zstd gzip

    # API бэкенда
    handle /api/* {
        reverse_proxy backend:8000 {
            header_up X-Real-IP {remote_host}
            header_up X-Forwarded-For {remote_host}
            transport http {
                dial_timeout 5s
                response_header_timeout 120s
                read_timeout 130s
            }
        }
    }

    # WebSocket
    handle /ws/* {
        reverse_proxy backend:8000
    }

    # Storage (изображения)
    handle /storage/* {
        root * /var/www
        file_server
    }

    # Frontend SPA (catch-all — должен быть последним)
    handle {
        root * /var/www/frontend
        try_files {path} /index.html
        file_server
    }

    # Upload limit для EPUB
    @uploads {
        path /api/v1/books/upload /api/v1/books/*/upload
    }
    request_body @uploads {
        max_size 50MB
    }

    # Security headers
    header {
        X-Frame-Options SAMEORIGIN
        X-Content-Type-Options nosniff
        Referrer-Policy strict-origin-when-cross-origin
        -Server
    }
}

# Мониторинг-дашборд — basicauth + reverse_proxy к 5 сервисам
monitor.fancai.ru {
    encode zstd gzip

    basic_auth {
        admin {$MONITOR_PASSWORD_HASH}
    }

    handle /netdata/* {
        uri strip_prefix /netdata
        reverse_proxy localhost:19999
    }

    handle /victoria/* {
        uri strip_prefix /victoria
        reverse_proxy localhost:8428
    }

    handle /uptime/* {
        uri strip_prefix /uptime
        reverse_proxy localhost:3001
    }

    handle /dozzle/* {
        uri strip_prefix /dozzle
        reverse_proxy localhost:8080
    }

    handle /flower/* {
        uri strip_prefix /flower
        reverse_proxy localhost:5555
    }

    handle {
        redir /netdata/ permanent
    }
}

# www -> non-www редирект
www.fancai.ru {
    redir https://fancai.ru{uri} permanent
}
