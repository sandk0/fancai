# Tier 2 (Enhanced) Environment Configuration
# Для: EC2 + RDS или Single EC2 с усиленной конфигурацией
# Скопируйте в .env.tier2 и заполните значения

# ============================================
# DATABASE (RDS db.t4g.small или локальный)
# ============================================
DB_USER=fancai_admin
DB_PASSWORD=YOUR_STRONG_PASSWORD_HERE
DB_HOST=fancai-db.xxxxxxxxxx.eu-central-1.rds.amazonaws.com
DB_PORT=5432
DB_NAME=fancai
DATABASE_URL=postgresql://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}

# Database pool settings (Enhanced)
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=30

# ============================================
# REDIS (ElastiCache cache.t3.small)
# ============================================
REDIS_HOST=fancai-redis.xxxxxx.0001.euc1.cache.amazonaws.com
REDIS_PORT=6379
REDIS_URL=redis://${REDIS_HOST}:${REDIS_PORT}/0

CELERY_BROKER_URL=redis://${REDIS_HOST}:${REDIS_PORT}/1
CELERY_RESULT_BACKEND=redis://${REDIS_HOST}:${REDIS_PORT}/2

# ============================================
# SECURITY
# ============================================
SECRET_KEY=your-64-char-secret-key-here
JWT_SECRET_KEY=another-64-char-secret-key-for-jwt

# ============================================
# GOOGLE AI (Gemini + Imagen)
# ============================================
GOOGLE_API_KEY=your-google-ai-api-key

# ============================================
# AWS S3
# ============================================
AWS_S3_BUCKET=fancai-storage-prod
AWS_REGION=eu-central-1
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key

# ============================================
# DOMAIN
# ============================================
DOMAIN_NAME=fancai.ru
DOMAIN_URL=https://fancai.ru
CORS_ORIGINS=https://fancai.ru

# ============================================
# APPLICATION (Enhanced)
# ============================================
DEBUG=false
LOG_LEVEL=INFO
WORKERS_COUNT=4

# Rate limiting (Enhanced)
RATE_LIMIT_PER_MINUTE=120
RATE_LIMIT_BURST=30

# ============================================
# TIER 2 LIMITS
# ============================================
# Max concurrent users: 150
# API requests/sec: 30-100
# Background jobs/min: 30
# DB connections: 150
# Redis operations/sec: 5000
