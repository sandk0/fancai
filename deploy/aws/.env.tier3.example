# Tier 3 (Pro) Environment Configuration
# Для: EC2 + RDS с максимальной производительностью
# Скопируйте в .env.tier3 и заполните значения

# ============================================
# DATABASE (RDS db.t4g.medium)
# ============================================
DB_USER=fancai_admin
DB_PASSWORD=YOUR_STRONG_PASSWORD_HERE
DB_HOST=fancai-db.xxxxxxxxxx.eu-central-1.rds.amazonaws.com
DB_PORT=5432
DB_NAME=fancai
DATABASE_URL=postgresql://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}

# Database pool settings (Pro)
DB_POOL_SIZE=50
DB_MAX_OVERFLOW=50

# ============================================
# REDIS (ElastiCache cache.t3.medium)
# ============================================
REDIS_HOST=fancai-redis.xxxxxx.0001.euc1.cache.amazonaws.com
REDIS_PORT=6379
REDIS_URL=redis://${REDIS_HOST}:${REDIS_PORT}/0

CELERY_BROKER_URL=redis://${REDIS_HOST}:${REDIS_PORT}/1
CELERY_RESULT_BACKEND=redis://${REDIS_HOST}:${REDIS_PORT}/2

# ============================================
# SECURITY
# ============================================
SECRET_KEY=your-64-char-secret-key-here
JWT_SECRET_KEY=another-64-char-secret-key-for-jwt

# ============================================
# GOOGLE AI (Gemini + Imagen)
# ============================================
GOOGLE_API_KEY=your-google-ai-api-key

# ============================================
# AWS S3
# ============================================
AWS_S3_BUCKET=fancai-storage-prod
AWS_REGION=eu-central-1
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key

# ============================================
# DOMAIN
# ============================================
DOMAIN_NAME=fancai.ru
DOMAIN_URL=https://fancai.ru
CORS_ORIGINS=https://fancai.ru

# ============================================
# APPLICATION (Pro)
# ============================================
DEBUG=false
LOG_LEVEL=INFO
WORKERS_COUNT=8

# Rate limiting (Pro)
RATE_LIMIT_PER_MINUTE=300
RATE_LIMIT_BURST=100

# Caching (Pro)
CACHE_TTL=3600
CACHE_MAX_SIZE=10000

# ============================================
# TIER 3 LIMITS
# ============================================
# Max concurrent users: 500
# API requests/sec: 100-300
# Background jobs/min: 100
# DB connections: 400
# Redis operations/sec: 15000
